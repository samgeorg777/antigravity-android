#!/data/data/com.agycli/files/usr/bin/python3
# ==============================================================================
# agy-widget: Antigravity Dynamic Custom Widget Engine for Android
# Allows Antigravity CLI (agy) and the user to create, customize, and control
# home screen widgets (colors, shapes, graphics, text, and actions).
# ==============================================================================

import sys
import os
import json
import argparse
import subprocess
import datetime

CYAN = "\033[38;2;0;240;255m"
BLUE = "\033[38;2;56;189;248m"
PURPLE = "\033[38;2;168;85;247m"
GREEN = "\033[38;2;34;197;94m"
RED = "\033[38;2;239;68;68m"
YELLOW = "\033[38;2;234;179;8m"
WHITE = "\033[38;2;248;250;252m"
GRAY = "\033[38;2;148;163;184m"
RESET = "\033[0m"
BOLD = "\033[1m"

def get_widget_dir():
    home = os.environ.get("HOME", "/data/data/com.agycli/files/home")
    wdir = os.path.join(home, ".antigravity", "widgets")
    os.makedirs(wdir, exist_ok=True)
    return wdir

def get_json_path():
    return os.path.join(get_widget_dir(), "widget.json")

def load_config():
    p = get_json_path()
    if os.path.exists(p):
        try:
            with open(p, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    sd_p = "/sdcard/.antigravity/widgets/widget.json"
    if os.path.exists(sd_p):
        try:
            with open(sd_p, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "title": "Antigravity Node",
        "title_color": "#00F0FF",
        "status": "ONLINE",
        "status_color": "#22C55E",
        "text": "Tap to launch Antigravity AI\nDefying system limits.",
        "text_color": "#E2E8F0",
        "shape": "chamfer",
        "bg": "#E60B0F19",
        "bg2": "#E6151B28",
        "border": "#00F0FF",
        "border_width": 3,
        "radius": 24,
        "show_overlay": True,
        "click_action": "open"
    }

def save_config(cfg):
    p = get_json_path()
    with open(p, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
    try:
        sd_dir = "/sdcard/.antigravity/widgets"
        os.makedirs(sd_dir, exist_ok=True)
        with open(os.path.join(sd_dir, "widget.json"), "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
    except Exception:
        pass

def trigger_update():
    # Broadcast to AntigravityWidgetProvider
    cmd = [
        "am", "broadcast", "--user", "0",
        "-a", "com.agycli.action.WIDGET_UPDATE",
        "-n", "com.agycli/com.termux.app.widget.AntigravityWidgetProvider"
    ]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{GREEN}[✓] Widget refreshed on Android home screen!{RESET}")
    except Exception as e:
        print(f"{YELLOW}[!] Notice: Update broadcast sent ({e}){RESET}")

def cmd_set(args):
    cfg = load_config()
    if args.title is not None: cfg["title"] = args.title
    if args.title_color is not None: cfg["title_color"] = args.title_color
    if args.status is not None: cfg["status"] = args.status
    if args.status_color is not None: cfg["status_color"] = args.status_color
    if args.text is not None: cfg["text"] = args.text.replace("\\n", "\n")
    if args.text_color is not None: cfg["text_color"] = args.text_color
    if args.shape is not None: cfg["shape"] = args.shape
    if args.bg is not None: cfg["bg"] = args.bg
    if args.bg2 is not None: cfg["bg2"] = args.bg2
    if args.border is not None: cfg["border"] = args.border
    if args.border_width is not None: cfg["border_width"] = args.border_width
    if args.radius is not None: cfg["radius"] = args.radius
    if args.overlay is not None: cfg["show_overlay"] = (args.overlay.lower() in ("true", "1", "yes"))
    if args.click is not None: cfg["click_action"] = args.click

    if args.btn1 or args.action1:
        cfg["btn1"] = cfg.get("btn1", {})
        if args.btn1: cfg["btn1"]["text"] = args.btn1
        if args.action1: cfg["btn1"]["action"] = args.action1
        if args.color1: cfg["btn1"]["color"] = args.color1

    if args.btn2 or args.action2:
        cfg["btn2"] = cfg.get("btn2", {})
        if args.btn2: cfg["btn2"]["text"] = args.btn2
        if args.action2: cfg["btn2"]["action"] = args.action2
        if args.color2: cfg["btn2"]["color"] = args.color2

    if args.btn3 or args.action3:
        cfg["btn3"] = cfg.get("btn3", {})
        if args.btn3: cfg["btn3"]["text"] = args.btn3
        if args.action3: cfg["btn3"]["action"] = args.action3
        if args.color3: cfg["btn3"]["color"] = args.color3

    if args.btn4 or args.action4:
        cfg["btn4"] = cfg.get("btn4", {})
        if args.btn4: cfg["btn4"]["text"] = args.btn4
        if args.action4: cfg["btn4"]["action"] = args.action4
        if args.color4: cfg["btn4"]["color"] = args.color4

    if args.image:
        set_image_file(args.image, cfg)

    save_config(cfg)
    trigger_update()

def trigger_refresh():
    cmd = [
        "am", "broadcast", "--user", "0",
        "-a", "com.agycli.action.WIDGET_REFRESH",
        "-n", "com.agycli/com.termux.app.widget.AntigravityWidgetProvider"
    ]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{GREEN}[✓] Triggered live widget refresh with haptics!{RESET}")
    except Exception as e:
        print(f"{YELLOW}[!] Notice: ({e}){RESET}")

def trigger_cycle_theme():
    cmd = [
        "am", "broadcast", "--user", "0",
        "-a", "com.agycli.action.WIDGET_CYCLE_THEME",
        "-n", "com.agycli/com.termux.app.widget.AntigravityWidgetProvider"
    ]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{GREEN}[✓] Morphed widget theme on home screen!{RESET}")
    except Exception as e:
        print(f"{YELLOW}[!] Notice: ({e}){RESET}")

def trigger_action(action_cmd):
    cmd = [
        "am", "broadcast", "--user", "0",
        "-a", "com.agycli.action.WIDGET_EXECUTE",
        "--es", "com.agycli.extra.COMMAND", action_cmd,
        "-n", "com.agycli/com.termux.app.widget.AntigravityWidgetProvider"
    ]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{GREEN}[✓] Triggered interactive widget action: {action_cmd}!{RESET}")
    except Exception as e:
        print(f"{YELLOW}[!] Notice: ({e}){RESET}")

def set_image_file(image_path, cfg=None):
    if not os.path.exists(image_path):
        print(f"{RED}[✗] Image not found: {image_path}{RESET}")
        return
    import shutil
    dest = os.path.join(get_widget_dir(), "widget.png")
    shutil.copyfile(image_path, dest)
    if cfg is not None:
        cfg["canvas_image"] = dest
    print(f"{GREEN}[✓] Widget image updated: {dest}{RESET}")

def cmd_image(args):
    cfg = load_config()
    set_image_file(args.path, cfg)
    save_config(cfg)
    trigger_update()

def get_system_stats():
    # Simple battery and mem stats
    stats = {"battery": "85%", "mem": "3.8 GB / 8.0 GB"}
    try:
        if os.path.exists("/sys/class/power_supply/battery/capacity"):
            with open("/sys/class/power_supply/battery/capacity") as f:
                stats["battery"] = f.read().strip() + "%"
        if os.path.exists("/proc/meminfo"):
            with open("/proc/meminfo") as f:
                lines = f.readlines()
                total = int(lines[0].split()[1]) // 1024
                avail = int(lines[2].split()[1]) // 1024
                used = total - avail
                stats["mem"] = f"{used // 1024}.{ (used % 1024) // 100 } GB / {total // 1024} GB"
    except Exception:
        pass
    return stats

