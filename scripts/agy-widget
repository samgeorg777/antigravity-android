def cmd_status(args):
    cfg = load_config()
    print(f"{CYAN}{BOLD}=== Current Antigravity Widget Config ==={RESET}")
    print(json.dumps(cfg, indent=2))
    png_path = os.path.join(get_widget_dir(), "widget.png")
    has_png = os.path.exists(png_path)
    print(f"{CYAN}Custom canvas image:{RESET} {'Present (' + png_path + ')' if has_png else 'None (using vector shapes)'}")

def cmd_clear_image(args):
    png_path = os.path.join(get_widget_dir(), "widget.png")
    if os.path.exists(png_path):
        os.remove(png_path)
        print(f"{GREEN}[✓] Cleared custom canvas image.{RESET}")
    cfg = load_config()
    cfg.pop("canvas_image", None)
    save_config(cfg)
    trigger_update()

def main():
    parser = argparse.ArgumentParser(
        description="Antigravity Custom Android Widget Controller",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  agy-widget template cosmic
  agy-widget template gauge
  agy-widget set --title "Server Monitor" --text "All systems normal" --shape chamfer --border "#00F0FF"
  agy-widget set --btn1 "Check Code" --action1 "agy 'git status'"
  agy-widget image /sdcard/Pictures/wallpaper.png
  agy-widget update
"""
    )
    sub = parser.add_subparsers(dest="command")

    # set
    p_set = sub.add_parser("set", help="Configure widget colors, text, shape, and actions")
    p_set.add_argument("--title", help="Widget title header")
    p_set.add_argument("--title-color", help="Hex color for title (e.g. #00F0FF)")
    p_set.add_argument("--status", help="Status pill text (e.g. ONLINE, BUSY)")
    p_set.add_argument("--status-color", help="Hex color for status badge")
    p_set.add_argument("--text", help="Multiline body text or stats")
    p_set.add_argument("--text-color", help="Hex color for body text")
    p_set.add_argument("--shape", choices=["chamfer", "rounded_rect", "pill", "circle", "hex", "nothing_pet", "pet"], help="Widget geometric shape")
    p_set.add_argument("--bg", help="Background hex color (e.g. #0B0F19)")
    p_set.add_argument("--bg2", help="Secondary background color for linear gradient")
    p_set.add_argument("--border", help="Border hex color")
    p_set.add_argument("--border-width", type=float, help="Border stroke width in pixels")
    p_set.add_argument("--radius", type=float, help="Corner radius in pixels")
    p_set.add_argument("--overlay", choices=["true", "false"], help="Show or hide text overlay")
    p_set.add_argument("--image", help="Path to custom image / canvas file")
    p_set.add_argument("--click", help="Action when tapping the widget body ('open' or bash command)")
    p_set.add_argument("--btn1", help="Button 1 label")
    p_set.add_argument("--action1", help="Button 1 command to execute")
    p_set.add_argument("--color1", help="Button 1 text color")
    p_set.add_argument("--btn2", help="Button 2 label")
    p_set.add_argument("--action2", help="Button 2 command to execute")
    p_set.add_argument("--color2", help="Button 2 text color")
    p_set.add_argument("--btn3", help="Button 3 label")
    p_set.add_argument("--action3", help="Button 3 command to execute")
    p_set.add_argument("--color3", help="Button 3 text color")
    p_set.add_argument("--btn4", help="Button 4 label")
    p_set.add_argument("--action4", help="Button 4 command to execute")
    p_set.add_argument("--color4", help="Button 4 text color")

    # image
    p_img = sub.add_parser("image", help="Set a custom PNG/JPG image to display on the widget")
    p_img.add_argument("path", help="Path to image file")

    # clear-image
    sub.add_parser("clear-image", help="Remove custom image and revert to vector shape")

    # template
    p_tpl = sub.add_parser("template", help="Apply a pre-built gorgeous widget template")
    p_tpl.add_argument("name", choices=["cosmic", "cyberpunk", "minimal", "gauge", "matrix", "checklist", "quote", "pet", "nothing", "cat"], help="Template name")

    # pet interactions
    sub.add_parser("pet", help="Trigger pet affection interaction live on widget")
    sub.add_parser("fish", help="Trigger feeding fish interaction live on widget")
    sub.add_parser("sleep", help="Toggle sleep mode live on widget")

    p_act = sub.add_parser("action", help="Send arbitrary interactive action to widget")
    p_act.add_argument("cmd", help="Action string (e.g. pet, fish, sleep, state:happy, refresh)")

    p_state = sub.add_parser("state", help="Set widget custom state")
    p_state.add_argument("name", help="State name")

    # update
    sub.add_parser("update", help="Send immediate update signal to Android home screen")

    # refresh
    sub.add_parser("refresh", help="Trigger live telemetry refresh with haptic feedback")

    # theme / cycle
    sub.add_parser("theme", help="Cycle widget shape and theme on the home screen")
    sub.add_parser("cycle", help="Cycle widget shape and theme on the home screen")

    # status
    sub.add_parser("status", help="Print current widget config")

    # demo
    sub.add_parser("demo", help="Initialize and display demo cosmic widget")

    args = parser.parse_args()

    if args.command == "set":
        cmd_set(args)
    elif args.command == "image":
        cmd_image(args)
    elif args.command == "clear-image":
        cmd_clear_image(args)
    elif args.command == "template":
        cmd_template(args)
    elif args.command == "pet":
        trigger_action("pet")
    elif args.command == "fish":
        trigger_action("fish")
    elif args.command == "sleep":
        trigger_action("sleep")
    elif args.command == "action":
        trigger_action(args.cmd)
    elif args.command == "state":
        trigger_action(f"state:{args.name}")
    elif args.command == "update":
        trigger_update()
    elif args.command == "refresh":
        trigger_refresh()
    elif args.command in ("theme", "cycle"):
        trigger_cycle_theme()
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "demo":
        args.name = "cosmic"
        cmd_template(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
